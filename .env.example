# DataHub Steward Squad — environment template.
#
# Copy to .env, fill in values, then load it into your shell:
#     cp .env.example .env
#     set -a && source .env && set +a
#
# .env is git-ignored — your keys and tokens never land in the repo.
#
# NOTE: none of this is required for the zero-credential offline demo
# (`mcp-demo` / `run --engine deterministic`). It powers the two "real" modes:
# the live DataHub loop (`mcp-demo --live`) and the Claude engine (`--engine llm`).

# --- Live DataHub MCP loop (`mcp-demo --live`) ---
# The real mcp-server-datahub connects to your DataHub GMS with these.
DATAHUB_GMS_URL=http://localhost:8080
# Optional locally: a quickstart with METADATA_SERVICE_AUTH_ENABLED=false needs
# no token. Required for DataHub Cloud or when GMS auth is enabled. Generate one
# at http://localhost:9002 -> Settings -> Access Tokens.
# DATAHUB_GMS_TOKEN=your-personal-access-token
# Enable mutation tools so approved writebacks can be applied (mcp-demo --live --apply):
TOOLS_IS_MUTATION_ENABLED=true

# --- Optional Claude engine (`--engine llm`) ---
# Anthropic API key — https://console.anthropic.com/settings/keys
# Requires API credits (separate from a Claude.ai subscription):
# https://console.anthropic.com/settings/billing
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the Claude model (default: claude-sonnet-5)
# STEWARD_LLM_MODEL=claude-opus-5

# Optional: max output tokens for the Chief Steward brief (default: 1200)
# STEWARD_LLM_MAX_TOKENS=1200
