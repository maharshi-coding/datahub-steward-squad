# DataHub Steward Squad — environment template.
#
# Copy to .env, fill in your key, then load it into your shell:
#     cp .env.example .env
#     set -a && source .env && set +a
#
# Only needed for `--engine llm` (real Claude reasoning). The default
# `--engine auto` and the full `mcp-demo` loop run WITHOUT any of this — they
# fall back to the deterministic engine when no key is present.

# Anthropic API key — https://console.anthropic.com/settings/keys
# Requires API credits (separate from a Claude.ai subscription):
# https://console.anthropic.com/settings/billing
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the Claude model (default: claude-sonnet-5)
# STEWARD_LLM_MODEL=claude-opus-5

# Optional: max output tokens for the Chief Steward brief (default: 1200)
# STEWARD_LLM_MAX_TOKENS=1200
